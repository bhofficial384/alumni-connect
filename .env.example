# ============================================
# AlumniConnect - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ============================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (MongoDB Atlas) ---
# Get your connection string from https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/alumniconnect?retryWrites=true&w=majority

# --- Authentication ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# --- Frontend URL (for CORS) ---
FRONTEND_URL=http://localhost:5173

# --- AI Feature (Optional - Anthropic Claude API) ---
# Get your API key from https://console.anthropic.com
# Leave empty to use the fallback template
ANTHROPIC_API_KEY=
