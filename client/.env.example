# ============================================
# AlumniConnect Client - Environment Configuration
# ============================================

# API Base URL
VITE_API_URL=http://localhost:5000/api

# Google Identity Services Client ID
# Created in Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web Application)
# Authorized JavaScript Origins: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=

# GitHub OAuth App Client ID
# Created in GitHub > Settings > Developer settings > OAuth Apps
# Authorization callback URL: http://localhost:5173/auth/github/callback
VITE_GITHUB_CLIENT_ID=
